// DUDAO trade portal — data model.
//
// This replaces the Shopify Admin API as the system of record. Everything the
// business owns lives here: catalog, customers, the payment ledger, invoices,
// staff accounts and settings.
//
// Money is Decimal(12,2), never Float. A trade counter reconciles cash at the
// end of every day and a half-penny drift compounds into a real discrepancy.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// Prisma 7 takes the connection URL from prisma.config.ts (for migrations) and
// from the driver adapter passed to PrismaClient (at runtime), not from here.
datasource db {
  provider = "postgresql"
}

/// Append-only audit trail for anything that moves money. Every invoice edit,
/// void, deletion, restore and every payment recorded or revoked is written
/// here with who did it and when. When a balance looks wrong, this is what lets
/// you reconstruct how it got that way. A hard-deleted invoice keeps its full
/// snapshot in `data`, so it can be restored from the log.
model AuditLog {
  id     String   @id @default(cuid())
  at     DateTime @default(now())
  /// Actor email, or "master-password", or "unknown". Never blocks the action.
  who    String   @default("")
  /// Dotted verb, e.g. "invoice.void".
  action String
  /// Id of the invoice/customer the action applied to.
  ref    String   @default("")
  /// Human label, e.g. DUD-2026-0042.
  name   String   @default("")
  /// Short summary, including amounts.
  detail String   @default("")
  /// Optional payload — the full invoice snapshot for a deletion, so it can be
  /// restored from the log.
  data   Json?

  @@index([at])
  @@index([action])
}

/// A shop expense — rent, stock purchases, utilities, wages, transport, etc.
/// Recorded for the books and pre-filled into the cash-up closing sheet.
model Expense {
  id          String   @id @default(cuid())
  /// The day the expense was incurred.
  date        DateTime @default(now())
  category    String
  description String   @default("")
  amount      Decimal  @db.Decimal(12, 2)
  /// cash | card | bank transfer | other — cash ones come out of the drawer.
  method      String   @default("cash")
  note        String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())

  @@index([date])
}

/// Buying / cost settlement — OWNER ONLY, separate from Expenses. Money spent
/// purchasing stock to resell; each entry can be flipped in or out of the
/// net-earnings calculation.
model Buying {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  supplier    String   @default("")
  description String   @default("")
  amount      Decimal  @db.Decimal(12, 2)
  /// Does it reduce net earnings right now?
  included    Boolean  @default(true)
  createdBy   String   @default("")
  createdAt   DateTime @default(now())

  @@index([date])
}

/// End-of-day cash-up. Staff count the drawer at close and record it against
/// what the till says should be there: variance = counted − float − expected
/// cash takings. Kept as history so a recurring discrepancy is visible.
model CashUp {
  id          String   @id @default(cuid())
  /// The trading day this settles, as YYYY-MM-DD.
  businessDay String
  createdAt   DateTime @default(now())
  who         String   @default("")
  /// Opening cash float left in the drawer.
  float        Decimal @default(0) @db.Decimal(12, 2)
  /// Cash takings the till expected today (non-revoked cash payments).
  expectedCash Decimal @default(0) @db.Decimal(12, 2)
  /// What was physically counted in the drawer.
  countedCash  Decimal @default(0) @db.Decimal(12, 2)
  /// countedCash − float − expectedCash. Negative = short, positive = over.
  variance     Decimal @default(0) @db.Decimal(12, 2)
  /// Full takings split {cash, card, bank, account, total} at cash-up time.
  byMethod    Json
  note        String   @default("")

  @@index([businessDay])
  @@index([createdAt])
}

/// In-database backup history. Each row is a full JSON snapshot of every other
/// table (never of this table — that would nest backups inside backups). A
/// convenience/rollback store that sits alongside the off-site Google Drive
/// copies; pruned to a rolling window. Survives a restore, which only touches
/// the business tables.
model Backup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// "auto" (nightly cron) or "manual" (owner clicked Back up now).
  kind      String   @default("auto")
  label     String   @default("")
  sizeBytes Int      @default(0)
  /// The full snapshot, as returned by buildBackupSnapshot().
  data      Json

  @@index([createdAt])
}

/// Portal settings. Single row, id is always 1.
model Setting {
  id Int @id @default(1)

  // Business identity — printed on every document
  name          String @default("DUDAO")
  tagline       String @default("Trade counter & wholesale")
  address       String @default("")
  email         String @default("")
  phone         String @default("")
  website       String @default("")
  taxNumber     String @default("")
  bankDetails   String @default("")
  invoiceFooter String @default("Thank you for your business.")

  // Trading rules
  invoicePrefix     String  @default("DUD")
  taxRate           Decimal @default(20) @db.Decimal(5, 2)
  lowStockThreshold Int     @default(5)
  currency          String  @default("GBP")

  faviconUrl String @default("")

  // Daily digest
  digestEnabled     Boolean @default(false)
  digestToCustomers Boolean @default(false)
  digestToOwner     Boolean @default(true)
  digestOwnerEmail  String  @default("")
  digestOwnerWa     String  @default("")
  /// YYYY-MM-DD of the last successful run — makes the cron idempotent.
  digestLastRun     String  @default("")

  requireTapIn     Boolean @default(false)
  reportButtonHour Int     @default(17)

  updatedAt DateTime @updatedAt
}

/// API secrets. Separate table so a settings query can never return them.
model Integration {
  id Int @id @default(1)

  whatsappToken        String @default("")
  whatsappPhoneId      String @default("")
  whatsappTemplate     String @default("")
  whatsappTemplateLang String @default("en")

  updatedAt DateTime @updatedAt
}

/// Sequential invoice numbering, restarting each calendar year.
model Counter {
  id   Int @id @default(1)
  year Int
  seq  Int @default(0)
}

/// Staff accounts. Owners come from PORTAL_OWNER_EMAIL and are not stored here
/// unless they set a password.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  phone        String   @default("")
  role         String   @default("member")
  /// scrypt as "salt:derived", both hex. Empty means no password set.
  passwordHash String   @default("")
  permissions  String[] @default([])
  createdAt    DateTime @default(now())

  invoices   Invoice[]
  attendance Attendance[]
}

/// One sellable item. Deliberately flat — a trade counter sells a part with a
/// SKU, not a size/colour matrix. Add a Variant model if that changes.
model Product {
  id              String  @id @default(cuid())
  handle          String  @unique
  title           String
  descriptionHtml String  @default("")
  /// ACTIVE | DRAFT | ARCHIVED
  status          String  @default("ACTIVE")
  vendor          String  @default("")
  brand           String  @default("")
  /// Free text; a part often fits several models.
  model           String  @default("")
  productType     String  @default("")
  tags            String[] @default([])

  sku     String @default("")
  barcode String @default("")

  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  // Null tier = falls back to `price`. Zero is not a price; see lib/pricing.ts.
  priceWholesale Decimal? @db.Decimal(12, 2)
  priceShop      Decimal? @db.Decimal(12, 2)
  priceEbay      Decimal? @db.Decimal(12, 2)
  priceAmazon    Decimal? @db.Decimal(12, 2)

  stock Int @default(0)

  images      ProductImage[]
  collections CollectionProduct[]
  lines       InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([sku])
  @@index([barcode])
  @@index([status])
  @@index([productType])
  @@index([stock])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model Collection {
  id              String  @id @default(cuid())
  handle          String  @unique
  title           String
  descriptionHtml String  @default("")
  imageUrl        String  @default("")
  /// Rule-driven collections are maintained by productType and are read-only
  /// in the product picker.
  smartRule       String  @default("")

  products  CollectionProduct[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Customer {
  id      String @id @default(cuid())
  name    String
  company String @default("")
  email   String @default("")
  phone   String @default("")

  address  String @default("")
  city     String @default("")
  postcode String @default("")
  country  String @default("United Kingdom")

  /// seg: keys — where this account trades with us.
  segments String[] @default([])

  /// Debt carried over from the old book on day one. Counts toward what they
  /// owe but has no invoice behind it.
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  creditLimit    Decimal? @db.Decimal(12, 2)

  /// Trade access code. Unused while there is no storefront, but kept so trade
  /// pricing can be switched on without a migration.
  tradeCode String? @unique

  notes String @default("")

  invoices Invoice[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
  @@index([email])
}

model Invoice {
  id     String @id @default(cuid())
  number String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Walk-in trade has no account, just a name on the bill.
  walkInName  String @default("")
  walkInPhone String @default("")

  /// Which channel the sale came through — drives the price tier used.
  segment String @default("shop")

  staffEmail String  @default("")
  staffName  String  @default("")
  staffId    String?
  staff      User?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  /// DRAFT | UNPAID | PAID | VOID
  status String @default("UNPAID")

  taxable  Boolean @default(true)
  taxRate  Decimal @default(0) @db.Decimal(5, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  notes    String  @default("")

  lines    InvoiceLine[]
  payments Payment[]

  issuedAt  DateTime  @default(now())
  paidAt    DateTime?
  voidedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@index([issuedAt])
  @@index([status])
  @@index([segment])
  @@index([customerId])
}

model InvoiceLine {
  id        String @id @default(cuid())
  invoiceId String

  /// Null for a custom line typed at the counter.
  productId String?

  /// Snapshot, not a lookup. An invoice must still print correctly after the
  /// product is renamed, repriced or deleted.
  title     String
  sku       String  @default("")
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  position  Int     @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId, position])
  @@index([productId])
}

model Payment {
  id String @id @default(cuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  amount Decimal @db.Decimal(12, 2)
  /// cash | card | bank | account
  method String  @default("cash")
  note   String  @default("")

  staffEmail String @default("")

  /// Revoked payments are kept, never deleted — the ledger must stay auditable.
  revoked   Boolean   @default(false)
  revokedAt DateTime?

  takenAt DateTime @default(now())

  @@index([takenAt])
  @@index([customerId])
  @@index([invoiceId])
}

model Attendance {
  id     String  @id @default(cuid())
  email  String
  name   String  @default("")
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  tapIn   DateTime  @default(now())
  tapOut  DateTime?
  /// True when the nightly job closed the shift rather than the staff member.
  autoOut Boolean   @default(false)

  @@index([email, tapIn])
}
