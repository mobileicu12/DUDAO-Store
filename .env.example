# ---------------------------------------------------------------------------
# Database — the system of record. PostgreSQL 14+.
#
# Local:      postgresql://postgres@localhost:5432/dudau
# Neon:       postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/dudau?sslmode=require
# Supabase:   postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#
# After setting this, run:  npx prisma migrate deploy
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres@localhost:5432/dudau"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=

# Optional. Leave blank to use email + password only.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma separated. These accounts always hold every permission and cannot be
# edited or removed from the team screen.
PORTAL_OWNER_EMAIL=owner@example.com

# openssl rand -base64 32
# Signs public invoice/statement links AND doubles as the emergency master
# password for owner access.
PORTAL_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Messaging (optional — send buttons hide themselves when unset)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="DUDAU <invoices@yourdomain.com>"
# WhatsApp credentials are NOT set here — they are entered in Settings and
# stored in the Integration table, which no API route ever returns.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business identity defaults. Anything saved in Settings overrides these.
NEXT_PUBLIC_BIZ_NAME=DUDAU
NEXT_PUBLIC_BIZ_TAGLINE=Trade counter & wholesale
# Use | or newlines to separate address lines
NEXT_PUBLIC_BIZ_ADDRESS=Unit 1|Example Street|London|SW1A 1AA
NEXT_PUBLIC_BIZ_EMAIL=
NEXT_PUBLIC_BIZ_PHONE=
NEXT_PUBLIC_BIZ_WEBSITE=
NEXT_PUBLIC_BIZ_VAT=
NEXT_PUBLIC_BIZ_BANK=
NEXT_PUBLIC_BIZ_FOOTER=Thank you for your business.
NEXT_PUBLIC_INVOICE_PREFIX=DUD
NEXT_PUBLIC_CURRENCY=GBP
NEXT_PUBLIC_TAX_RATE=20

# ---------------------------------------------------------------------------
# Off-site backup — Cloudflare R2 (or any S3-compatible bucket)
#
# The nightly backup always saves a copy inside the database. Set these four
# values ONCE and it also uploads an off-site copy to R2 every night, keeping
# the last 30. R2 uses a STATIC access key that never expires — unlike the old
# Google Drive token, there is nothing to re-authorise later.
#
# One-time setup:
#   1. Cloudflare dashboard → R2 → create a bucket (e.g. "dudao-backups").
#   2. R2 → Manage API Tokens → create a token with Object Read & Write.
#   3. Copy the Access Key ID, Secret Access Key and your Account ID below.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override the endpoint for a non-R2 S3 provider (e.g. Backblaze B2).
# R2_ENDPOINT=

# ---------------------------------------------------------------------------
# Ops
# ---------------------------------------------------------------------------
# Bearer token the daily digest cron must present.
CRON_SECRET=
# Set to 1 to enable the staff time clock (owner must also switch it on).
ENABLE_TAPIN=
